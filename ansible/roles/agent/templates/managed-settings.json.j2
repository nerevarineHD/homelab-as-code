{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(wc *)"
    ],
    "deny": [
      "Bash(tofu apply *)",
      "Bash(tofu destroy *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(ansible-vault *)",
      "Bash(ansible-playbook *)",
      "Bash(git push *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(pct *)",
      "Bash(qm *)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(//etc/claude-code/**)",
      "Edit(//etc/**)",
      "Edit(~/.claude/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)"
    ]
  },
  "allowManagedPermissionRulesOnly": true,
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/agent-guard"
          }
        ]
      }
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  }
}
