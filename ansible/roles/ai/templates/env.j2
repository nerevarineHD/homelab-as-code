# Managed by Ansible (roles/ai) - secrets rendered from Vault.
WEBUI_SECRET_KEY={{ vault_openwebui_secret_key }}
# Two OpenRouter connections: general (no extra guardrail) and private (ZDR guardrail).
# Seeded on first start only (Open WebUI stores connections in its database afterwards);
# set the prefixes "cloud" / "private" in Admin Panel -> Settings -> Connections.
OPENAI_API_BASE_URLS=https://openrouter.ai/api/v1;https://openrouter.ai/api/v1
OPENAI_API_KEYS={{ vault_openrouter_general_key }};{{ vault_openrouter_private_key }}
