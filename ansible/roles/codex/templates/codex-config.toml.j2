# Managed by Ansible (roles/codex). No credentials belong in this file.
# Research stage: edits in the working project and hosted public web search.
sandbox_mode = "workspace-write"
approval_policy = "on-request"
web_search = "live"
check_for_update_on_startup = false

[sandbox_workspace_write]
