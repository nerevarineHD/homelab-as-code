# {{ ansible_managed }}
maxretry = 3

[{{ nut_ups_name }}]
  driver = usbhid-ups
  port = auto
  vendorid = {{ nut_ups_vendorid }}
  productid = {{ nut_ups_productid }}
  desc = "{{ nut_ups_desc }}"
  # Ignore the UPS's own low-battery flag; raise it ourselves at whichever comes first.
  ignorelb
  override.battery.charge.low = {{ nut_shutdown_charge }}
  override.battery.runtime.low = {{ nut_shutdown_runtime }}
