# Managed by Ansible (role: stardew). Edit the role or Vault, not this file.
# Secrets are single-quoted so Docker Compose doesn't expand any $ in them.
COMPOSE_PROJECT_NAME={{ stardew_project }}
IMAGE_VERSION={{ stardew_image_version }}

STEAM_USERNAME='{{ vault_stardew_steam_username }}'
STEAM_PASSWORD='{{ vault_stardew_steam_password }}'
VNC_PASSWORD='{{ vault_stardew_vnc_password }}'

SERVER_NAME="{{ stardew_server_name }}"
SERVER_PASSWORD='{{ vault_stardew_server_password }}'
API_KEY='{{ vault_stardew_api_key }}'

# Ports stay at upstream defaults: UDP 24642 game, UDP 27015 Steam query,
# TCP 5800 VNC admin, TCP 8080 API.
{% if stardew_discord_enabled %}

COMPOSE_PROFILES=discord
DISCORD_BOT_TOKEN='{{ vault_stardew_discord_bot_token }}'
{% endif %}
