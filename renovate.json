{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "America/Los_Angeles",
  "schedule": ["before 6am on saturday"],
  "prConcurrentLimit": 5,
  "labels": ["renovate"],
  "ignorePaths": ["cts/**", "host/**", "proxmox/**"],
  "enabledManagers": ["docker-compose", "custom.regex", "github-actions", "terraform"],
  "docker-compose": {
    "managerFilePatterns": ["/(^|/)docker-compose[^/]*\\.ya?ml(\\.j2)?$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions in role defaults, marked with a '# renovate:' comment on the line above",
      "managerFilePatterns": ["/^ansible/roles/[^/]+/defaults/main\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*\\w+:\\s*\"?(?:[^\"\\s:]+:)?(?<currentValue>[^\"\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\"?"
      ],
      "extractVersionTemplate": "{{#if (equals datasource 'github-releases')}}^v?(?<version>.*)${{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "linuxserver.io tags: <app version>[_v<lib>]-ls<build>",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/**"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:_v[\\d.]+)?-ls(?<revision>\\d+)$"
    },
    {
      "description": "Omada controller upgrades get looked at, one at a time",
      "matchPackageNames": ["mbentley/omada-controller"],
      "pinDigests": true,
      "prPriority": -1
    },
    {
      "description": "Stardew server is a pre-release project; previews are the only releases",
      "matchPackageNames": ["sdvd/server"],
      "ignoreUnstable": false
    },
    {
      "description": "One PR a week for every :latest digest bump",
      "matchUpdateTypes": ["digest"],
      "groupName": "image digests"
    }
  ]
}
